PORT=4000
FRONTEND_URL=http://localhost:3000

# --- Security (all REQUIRED when NODE_ENV=production; the server refuses to start without them) ---
# Clerk: the backend verifies the signed session token on every request.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Encrypts every stored agreement and document (AES-256-GCM). Losing it makes stored data unreadable.
DATA_ENCRYPTION_KEY=

# --- AI (optional; rule-based explanations are used without it) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Storage (optional; defaults to encrypted files in backend/.data) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=agreement-documents

# --- OCR ---
# Tesseract languages, e.g. "eng" or "eng+hin" (extra language data downloads on first use)
OCR_LANGS=eng
MAX_PDF_PAGES=40
MAX_OCR_PAGES=15
# Optional: Google Cloud Vision for higher-accuracy OCR
GOOGLE_APPLICATION_CREDENTIALS=

# Payments (optional). Use Razorpay TEST keys (rzp_test_...) from dashboard.razorpay.com; no real money moves.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
